@model DotNetSigningServer.Controllers.BillingController.BillingViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<DotNetSigningServer.Resources.SharedStrings> L
@{
    ViewData["Title"] = L["BillingTitle"].Value;
    var culture = System.Globalization.CultureInfo.CurrentUICulture;
    string money(decimal v) => DotNetSigningServer.Services.Pricing.CreditPricing.FormatAmount(v, culture);
    int discount(DotNetSigningServer.Services.Pricing.CreditPack p) => p.DiscountPercentVersus(Model.PricePer100 ?? 0m);
    // Without a price list nothing is sold: no prices and no checkout, never a price of 0 (#175).
    bool hasPacks = Model.Packs.Count > 0;
    var pm = Model.SavedPaymentMethod;
    bool hasCard = pm != null;
    // Known statuses are translated; an unknown one is shown as the service sent it.
    string InvoiceStatusLabel(string status)
    {
        var key = "InvoiceStatus_" + status.ToLowerInvariant();
        var translated = L[key];
        return translated.ResourceNotFound ? char.ToUpper(status[0]) + status.Substring(1) : translated.Value;
    }
}
<h1 class="content-box-title">@L["BillingTitle"]</h1>

@if (TempData["Error"] != null)
{
    <div class="flash error">@TempData["Error"]</div>
}
@if (TempData["Info"] != null)
{
    <div class="flash info">@TempData["Info"]</div>
}

@if (Model.IsEnterprise)
{
    <div class="billing-grid">
        <div class="card">
            <h2 class="card-title">@L["EnterpriseBillingHeading"]</h2>
            <p class="muted" style="margin-bottom:1rem">@L["EnterpriseBillingDescription"]</p>

            <div class="billing-usage-summary" style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem;margin-bottom:1.25rem">
                <div style="padding:0.75rem;border:1px solid var(--color-card-border,#e5e7eb);border-radius:6px">
                    <p class="muted" style="font-size:0.8rem;margin:0 0 0.25rem">@L["UsageToday"]</p>
                    <p style="font-size:1.5rem;font-weight:600;margin:0">@Model.UsageToday</p>
                </div>
                <div style="padding:0.75rem;border:1px solid var(--color-card-border,#e5e7eb);border-radius:6px">
                    <p class="muted" style="font-size:0.8rem;margin:0 0 0.25rem">@L["UsageLast7Days"]</p>
                    <p style="font-size:1.5rem;font-weight:600;margin:0">@Model.UsageLast7Days</p>
                </div>
                <div style="padding:0.75rem;border:1px solid var(--color-card-border,#e5e7eb);border-radius:6px">
                    <p class="muted" style="font-size:0.8rem;margin:0 0 0.25rem">@L["UsageLast30Days"]</p>
                    <p style="font-size:1.5rem;font-weight:600;margin:0">@Model.UsageLast30Days</p>
                </div>
            </div>

            @if (pm != null)
            {
                <hr style="border:none;border-top:1px solid var(--color-card-border,#e5e7eb);margin:1.25rem 0" />
                <h3 class="billing-pricing-title">@L["SavedPaymentMethod"]</h3>
                <p style="margin-bottom:0.5rem;display:flex;align-items:center;gap:0.5rem">
                    @if (pm.Type == "card")
                    {
                        <span style="text-transform:capitalize;font-weight:500">@pm.Brand</span>
                        <span class="muted">•••• @pm.Last4</span>
                        <span class="muted" style="font-size:0.875rem">(@($"{pm.ExpMonth:D2}/{pm.ExpYear % 100:D2}"))</span>
                    }
                    else if (pm.Type == "link")
                    {
                        <span style="font-weight:500">Link</span>
                        <span class="muted">@pm.LinkEmail</span>
                    }
                    else
                    {
                        <span style="text-transform:capitalize;font-weight:500">@pm.Type</span>
                    }
                </p>
                <p class="muted" style="font-size:0.875rem;margin-bottom:0.75rem">@L["ManagePaymentMethodDescription"]</p>
                <form method="post" action="/Billing/ManagePaymentMethod">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-small btn-secondary">@L["ManagePaymentMethod"]</button>
                </form>
            }
        </div>

        <div class="card">
            <h3 class="billing-pricing-title" style="margin-top:0">@L["DailyBreakdown"]</h3>
            <div class="table-wrapper" style="margin-bottom:1.25rem">
                <table class="table">
                    <thead>
                        <tr>
                            <th>@L["Date"]</th>
                            <th style="text-align:right">@L["Credits"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bucket in Model.DailyUsage)
                        {
                            <tr>
                                <td>@bucket.PeriodStart.ToString("yyyy-MM-dd")</td>
                                <td style="text-align:right">@bucket.Credits</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <h3 class="billing-pricing-title">@L["MonthlyBreakdown"]</h3>
            <div class="table-wrapper">
                <table class="table">
                    <thead>
                        <tr>
                            <th>@L["Month"]</th>
                            <th style="text-align:right">@L["Credits"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bucket in Model.MonthlyUsage)
                        {
                            <tr>
                                <td>@bucket.PeriodStart.ToString("yyyy-MM")</td>
                                <td style="text-align:right">@bucket.Credits</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="billing-grid">
        <div class="card">
            <h2 class="card-title">@L["BillingYourCredits"]</h2>
            <p class="billing-credits-remaining"><strong>@L["BillingRemaining"]</strong> @Model.CreditsRemaining</p>
            <p class="billing-credits-note">@L["BillingFreeCreditsNote"]</p>

            @if (hasPacks)
            {
                <h3 class="billing-pricing-title" id="pricing">@L["BillingPricing"]</h3>
                <div class="billing-pricing-list">
                    @foreach (var pack in Model.Packs)
                    {
                        <p class="billing-pricing-item">@L["BillingPackLine", pack.Quantity, money(pack.Amount), pack.Currency]
                            @if (discount(pack) > 0)
                            {
                                <span class="discount">@L["BillingPercentOff", discount(pack)]</span>
                            }
                        </p>
                    }
                </div>
            }

            <h3 class="billing-pricing-title" style="margin-top:1.25rem">@L["ConcurrencyPricingTitle"]</h3>
            <p class="muted" style="font-size:0.875rem;margin-bottom:0.5rem">@L["ConcurrencyPricingDescription"]</p>
            <ul class="billing-pricing-list" style="padding-left:1.25rem;margin:0">
                <li class="billing-pricing-item">@L["ConcurrencyTier1"]</li>
                <li class="billing-pricing-item">@L["ConcurrencyTier2"]</li>
                <li class="billing-pricing-item">@L["ConcurrencyTier3"]</li>
                <li class="billing-pricing-item">@L["ConcurrencyTier4"]</li>
            </ul>
            <p class="muted" style="font-size:0.875rem;margin-top:0.5rem">
                <a href="/ApiTokens">@L["ConfigureConcurrencyLink"]</a>
            </p>

            <hr style="border:none;border-top:1px solid var(--color-card-border,#e5e7eb);margin:1.25rem 0" />

            <h3 class="billing-pricing-title">@L["SavedPaymentMethod"]</h3>
            @if (pm != null)
            {
                <p style="margin-bottom:0.5rem;display:flex;align-items:center;gap:0.5rem">
                    @if (pm.Type == "card")
                    {
                        <span style="text-transform:capitalize;font-weight:500">@pm.Brand</span>
                        <span class="muted">•••• @pm.Last4</span>
                        <span class="muted" style="font-size:0.875rem">(@($"{pm.ExpMonth:D2}/{pm.ExpYear % 100:D2}"))</span>
                    }
                    else if (pm.Type == "link")
                    {
                        <span style="font-weight:500">Link</span>
                        <span class="muted">@pm.LinkEmail</span>
                    }
                    else
                    {
                        <span style="text-transform:capitalize;font-weight:500">@pm.Type</span>
                    }
                </p>
                <p class="muted" style="font-size:0.875rem;margin-bottom:0.75rem">@L["ManagePaymentMethodDescription"]</p>
                <form method="post" action="/Billing/ManagePaymentMethod" style="margin-bottom:1.25rem">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-small btn-secondary">@L["ManagePaymentMethod"]</button>
                </form>
            }
            else
            {
                <p class="muted" style="font-size:0.875rem;margin-bottom:1.25rem">@L["NoCardOnFile"]</p>
            }

            <hr style="border:none;border-top:1px solid var(--color-card-border,#e5e7eb);margin:1.25rem 0" />

            <h3 class="billing-pricing-title">@L["AutoRechargeTitle"]</h3>
            @if (Model.AutoRechargeEnabled)
            {
                <p style="margin-bottom:0.5rem">
                    <span class="billing-status billing-status--active">
                        <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#16a34a;margin-right:6px"></span>@L["AutoRechargeActive"]
                    </span>
                </p>
                <p class="muted" style="font-size:0.875rem;margin-bottom:0.25rem">
                    @Html.Raw(string.Format(L["AutoRechargeActiveDescription"].Value, Model.AutoRechargeQuantity, DotNetSigningServer.Services.AutoRechargeService.ThresholdCredits))
                </p>
                @if (Model.PricePer100 is { } nowPer100 && Model.AutoRechargePricePer100 > 0 && nowPer100 != Model.AutoRechargePricePer100)
                {
                    <p style="font-size:0.875rem;color:#dc2626;margin-bottom:0.5rem">
                        @L["AutoRechargePriceChanged", money(Model.AutoRechargePricePer100), Model.Currency, money(nowPer100)]
                    </p>
                }
                <form method="post" action="/Billing/AutoRecharge/Disable" style="margin-top:0.5rem">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-small btn-secondary" style="color:#dc2626;border-color:#fca5a5;background:transparent"
                        data-confirm="@L["AutoRechargeDisableConfirm"]">
                        @L["AutoRechargeDisable"]
                    </button>
                </form>
            }
            else if (Model.LastPurchaseQuantity > 0)
            {
                <p class="muted" style="font-size:0.875rem;margin-bottom:0.75rem">
                    @Html.Raw(string.Format(L["AutoRechargeEnableDescription"].Value, Model.LastPurchaseQuantity, DotNetSigningServer.Services.AutoRechargeService.ThresholdCredits))
                </p>
                <form method="post" action="/Billing/AutoRecharge/Enable">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="quantity" value="@Model.LastPurchaseQuantity" />
                    <button type="submit" class="btn-small btn-secondary">
                        @L["AutoRechargeEnable"]
                    </button>
                </form>
            }
            else
            {
                <p class="muted" style="font-size:0.875rem">
                    @L["AutoRechargePurchaseFirst"]
                </p>
            }
        </div>

        @if (hasPacks)
        {
            <div class="card">
                <h2 class="card-title">@L["BuyMoreCredits"]</h2>
                <p class="billing-buy-description">@L["BuyCreditsDescription"]</p>
                <form method="post" action="/Billing/Checkout" style="display:flex;flex-direction:column;gap:0.5rem;">
                    @Html.AntiForgeryToken()
                    <p class="billing-buy-label">@L["CreditsToBuy"]</p>

                    <div class="billing-options">
                        @for (var i = 0; i < Model.Packs.Count; i++)
                        {
                            var pack = Model.Packs[i];
                            <div class="billing-option">
                                <input type="radio" id="credits-@pack.Quantity" name="documentsToBuy" value="@pack.Quantity" checked="@(i == 0)">
                                <label for="credits-@pack.Quantity" class="billing-option-label">
                                    <span class="billing-option-radio"></span>
                                    <span class="billing-option-credits">@L["PackCredits", pack.Quantity]</span>
                                    <span class="billing-option-price">@L["PackFor", money(pack.Amount), pack.Currency]</span>
                                    @if (discount(pack) > 0)
                                    {
                                        <span class="billing-option-discount">@L["BillingPercentOff", discount(pack)]</span>
                                    }
                                </label>
                            </div>
                        }
                    </div>

                    <label class="billing-save-card" style="display:flex;align-items:flex-start;gap:0.5rem;margin-top:0.75rem;cursor:pointer">
                        <input type="checkbox" name="autoRecharge" value="true" style="margin-top:0.2rem" @(hasCard ? "checked" : "") />
                        <span>
                            <span style="font-weight:500">@L["SaveCardLabel"]</span>
                            <span class="muted" style="display:block;font-size:0.8rem;margin-top:0.125rem">@L["SaveCardHint"]</span>
                        </span>
                    </label>

                    <p class="billing-payment-note">@L["PaymentNextStep"]</p>

                    <button class="full-w btn-secondary" type="submit">@L["PlaceOrder"]</button>

                    <p class="muted">
                        @Html.Raw(string.Format(L["CheckoutNote"].Value,
                            "<a href=\"/Legal/TermsOfService\">" + System.Net.WebUtility.HtmlEncode(L["CheckoutTermsLink"].Value) + "</a>",
                            "<a href=\"/Legal/PrivacyPolicy\">" + System.Net.WebUtility.HtmlEncode(L["CheckoutPrivacyLink"].Value) + "</a>"))
                    </p>
                </form>
            </div>
        }
    </div>
}

<section class="billing-invoices">
    <h2 class="billing-invoices-title">@L["InvoicesTitle"]</h2>
    <div class="table-wrapper">
        @if (Model.StripeInvoices.Any())
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>@L["InvoiceNumber"]</th>
                        <th>@L["InvoicePrice"]</th>
                        <th>@L["InvoiceStatus"]</th>
                        <th>@L["InvoiceDownload"]</th>
                        <th>@L["Date"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in Model.StripeInvoices)
                    {
                        <tr>
                            <td>@(invoice.Number ?? "-")</td>
                            <td>@(invoice.AmountDueMinor / 100.0m) @invoice.Currency</td>
                            <td><span
                                    class="billing-status billing-status--@invoice.Status.ToLower()">@InvoiceStatusLabel(invoice.Status)</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(invoice.HostedInvoiceUrl))
                                {
                                    <a href="@invoice.HostedInvoiceUrl" class="billing-download-link" target="_blank"
                                        rel="noreferrer noopener">@L["InvoiceOpen"]</a>
                                }
                                else
                                {
                                    @("-")
                                }
                            </td>
                            <td>
                                @{
                                    var createdAt = invoice.Created;
                                    var createdDisplay = createdAt == default ? "-" : createdAt.ToUniversalTime().ToString("d");
                                }
                                @createdDisplay
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="muted m-4">@L["InvoicesNone"]</p>
        }
    </div>
</section>

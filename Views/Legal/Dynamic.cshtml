@model DotNetSigningServer.Services.Legal.LegalDocumentRendered
@* Model comes from ILegalDocumentSource: the P4 Backoffice service's document (HTML
   sanitized by the service) or its snapshot in LegalDocuments. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<DotNetSigningServer.Resources.SharedStrings> L
@{
    ViewData["Title"] = Model.Title;
    // Prefer the editor's "key changes" note; fall back to the document title.
    ViewData["MetaDescription"] = string.IsNullOrWhiteSpace(Model.Summary)
        ? $"{Model.Title} — Performance4PDF"
        : Model.Summary;
    var culture = System.Globalization.CultureInfo.CurrentUICulture;
    var versionLabel = string.Format(culture, L["LegalDocVersion"].Value, Model.Version);
    var effectiveFromLabel = Model.EffectiveFrom is { } effectiveFrom
        ? string.Format(culture, L["LegalDocEffectiveFrom"].Value, effectiveFrom.LocalDateTime)
        : null;
}

<div class="legal-document">
    <h1>@Model.Title</h1>
    <p><em>@versionLabel@(effectiveFromLabel is null ? "" : " · " + effectiveFromLabel)</em></p>

    @if (!string.IsNullOrWhiteSpace(Model.Summary))
    {
        <div class="legal-document__summary">
            <strong>@L["LegalDocKeyChanges"]</strong>
            <p>@Model.Summary</p>
        </div>
    }

    @* The P4 Backoffice service's HTML, which the service sanitizes before serving. *@
    @Html.Raw(Model.ContentHtml)

    @if (Model.Slug == "cookies-policy")
    {
        @* The service's cookie declaration (Docs On, from memory or the snapshot); without one
           the audited list, so the page always names the cookies actually set. *@
        var declaration = ViewData[DotNetSigningServer.Controllers.LegalController.CookieDeclarationKey]
            as DotNetSigningServer.Services.Legal.CookieDeclarationSnapshot;
        <partial name="_CookieTable" model="declaration?.Cookies ?? DotNetSigningServer.Services.Legal.AuditedCookies.For(L)" />
    }
</div>

@* Razor fallback of the cookies policy (Docs module Off, or no text from the service yet).
   Lists exactly the cookies of the audit (AuditedCookies); no analytics or marketing cookies. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<DotNetSigningServer.Resources.SharedStrings> L
@{
    ViewData["Title"] = L["LegalCookiesPolicy"].Value;
    ViewData["MetaDescription"] = L["LegalCookiesPolicyMeta"].Value;
}

<div class="legal-document">
    <h1>@L["LegalCookiesPolicy"]</h1>
    <p><em>@L["LegalLastUpdated"] 28. 9. 2026</em></p>

    <p>@L["CookiesPolicyIntro"]</p>

    <h2>@L["CookiesPolicyWhatTitle"]</h2>
    <p>@L["CookiesPolicyWhatText"]</p>

    <h2>@L["CookiesPolicyUsedTitle"]</h2>
    <p>@L["CookiesPolicyUsedText"]</p>
    <partial name="_CookieTable" model="DotNetSigningServer.Services.Legal.AuditedCookies.For(L)" />

    <h2>@L["CookiesPolicyManageTitle"]</h2>
    <p>@L["CookiesPolicyManageText"]</p>

    <h2>@L["CookiesPolicyChangesTitle"]</h2>
    <p>@L["CookiesPolicyChangesText"]</p>
</div>

@inject Microsoft.Extensions.Localization.IStringLocalizer<DotNetSigningServer.Resources.SharedStrings> L
@{
    ViewData["Title"] = L["LegalTitle"].Value;
    ViewData["MetaDescription"] = L["LegalMetaDescription"].Value;
}

<div class="legal-list">
    <h1>@L["LegalTitle"]</h1>
    <p>@L["LegalDescription"]</p>

    <ul>
        <li><a href="@Url.Action("TermsOfService", "Legal")">@L["LegalTermsOfService"]</a></li>
        <li><a href="@Url.Action("PrivacyPolicy", "Legal")">@L["LegalPrivacyPolicy"]</a></li>
        <li><a href="@Url.Action("DataProcessingAgreement", "Legal")">@L["LegalDpa"]</a></li>
        <li><a href="@Url.Action("ServiceLevelAgreement", "Legal")">@L["LegalSla"]</a></li>
        <li><a href="@Url.Action("RefundPolicy", "Legal")">@L["LegalRefundPolicy"]</a></li>
        <li><a href="@Url.Action("CookiesPolicy", "Legal")">@L["LegalCookiesPolicy"]</a></li>
        <li><a href="@Url.Action("OpenSourceNotices", "Legal")">@L["LegalOpenSourceNotices"]</a></li>
        <li><a href="@Url.Action("License", "Legal")">@L["LegalAgplLicense"]</a></li>
    </ul>
</div>

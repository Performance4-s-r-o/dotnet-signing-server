@inject Microsoft.Extensions.Localization.IStringLocalizer<DotNetSigningServer.Resources.SharedStrings> L
@inject Microsoft.Extensions.Options.IOptions<DotNetSigningServer.Options.OsTicketOptions> OsTicket
@inject Microsoft.Extensions.Options.IOptions<DotNetSigningServer.Options.AppOptions> App
@{
    var supportEnabled = OsTicket.Value.IsConfigured;
    var pageTitle = ViewData["Title"] as string;
    const string brandSuffix = "Performance4PDF";
    var fullTitle = string.IsNullOrWhiteSpace(pageTitle)
    ? brandSuffix
    : $"{pageTitle} | {brandSuffix}";
    var metaDescription = ViewData["MetaDescription"] as string ?? L["MetaDescriptionDefault"].Value;
    // Private pages (account, billing, admin, support…) set this so they never
    // reach the index — they are behind auth and have no search value.
    var noIndex = ViewData["NoIndex"] as bool? ?? false;
    var request = ViewContext?.HttpContext?.Request;
    // Configured origin, not the request host — canonical and hreflang must name
    // one public URL per page regardless of which hostname served it.
    var origin = App.Value.BaseUrl;
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var displayName = isAuthenticated ? User?.Identity?.Name : null;
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    var supportedCultures = new[] { "en", "cs", "de", "es" };
    if (!supportedCultures.Contains(currentCulture))
    {
        currentCulture = "en";
    }
    var cultureLabels = new Dictionary<string, string>
    {
        { "en", "EN" },
        { "cs", "CZ" },
        { "de", "DE" },
        { "es", "ES" }
    };
    var cultureNames = new Dictionary<string, string>
    {
        { "en", "English" },
        { "cs", "Čeština" },
        { "de", "Deutsch" },
        { "es", "Español" }
    };
    var currentReturnUrl = request != null ? (request.Path + request.QueryString) : "/";
    var controllerName = ViewContext?.RouteData?.Values?["controller"]?.ToString() ?? string.Empty;
    var isAccountPage = controllerName.Equals("Account", StringComparison.OrdinalIgnoreCase);
    var isHomePage = string.Equals(ViewContext?.HttpContext?.Request?.Path.Value, "/", StringComparison.Ordinal);

    // Locale lives in the `culture` query string (handled out of the box by
    // QueryStringRequestCultureProvider), so every language has its own URL that
    // a crawler can reach without a cookie. English is the default and keeps the
    // clean URL, which is also the x-default target.
    string LocaleUrl(string culture)
    {
        if (request == null) return string.Empty;
        var kept = request.Query
            .Where(q => !string.Equals(q.Key, "culture", StringComparison.OrdinalIgnoreCase)
                        && !string.Equals(q.Key, "ui-culture", StringComparison.OrdinalIgnoreCase))
            .SelectMany(q => q.Value.Select(v => $"{Uri.EscapeDataString(q.Key)}={Uri.EscapeDataString(v ?? string.Empty)}"))
            .ToList();
        if (culture != "en") kept.Insert(0, $"culture={culture}");
        var query = kept.Count > 0 ? "?" + string.Join("&", kept) : string.Empty;
        return $"{origin}{request.Path}{query}";
    }

    var canonicalUrl = LocaleUrl(currentCulture);
}
<!DOCTYPE html>
<html lang="@currentCulture">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>
    <meta name="description" content="@metaDescription" />
    @if (noIndex)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    <link rel="canonical" href="@canonicalUrl" />
    @if (!noIndex)
    {
        foreach (var loc in supportedCultures)
        {
            <link rel="alternate" hreflang="@loc" href="@LocaleUrl(loc)" />
        }
        <link rel="alternate" hreflang="x-default" href="@LocaleUrl("en")" />
    }
    <link rel="icon" href="/img/logo-64.png" type="image/png" asp-append-version="true" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:site_name" content="Performance4PDF" />
    <meta property="og:locale" content="@currentCulture" />
    <meta property="og:image" content="@origin/img/logo.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@fullTitle" />
    <meta name="twitter:description" content="@metaDescription" />
    <meta name="twitter:image" content="@origin/img/logo.png" />
    @* Static assets are served with a one-week max-age, so the URL has to change
       when the file does — otherwise edits stay invisible behind the cache. *@
    <link rel="stylesheet" href="/css/custom.css" asp-append-version="true" />
    @* Entity signals: tells search engines that "Performance4PDF" is this product, published
       by this company. Pages may add their own graph via ViewData["JsonLd"]. *@
    <script type="application/ld+json">@Html.Raw(DotNetSigningServer.Services.StructuredData.SiteJsonLd(origin, metaDescription))</script>
    @if (ViewData["JsonLd"] is string extraJsonLd && !string.IsNullOrWhiteSpace(extraJsonLd))
    {
        <script type="application/ld+json">@Html.Raw(extraJsonLd)</script>
    }
</head>

<body>
    <header class="header">
        <div class="header-container">
            <div class="header-inner">
                <a href="/" style="text-decoration: none; color: white" class="header-logo">
                    <div class="full-height">
                        <img src="/img/logo-64.png" width="40" height="40" alt="Performance4PDF" style="width:auto" asp-append-version="true" />
                        <div class="header-logo-wordmark">
                            <strong>Performance4</strong><span>PDF</span>
                        </div>
                    </div>
                </a>
                <div class="header-right">
                    @if (isAuthenticated)
                    {
                        <nav class="header-nav">
                            <a href="/Templates">@L["NavPdfTemplates"]</a>
                            <a href="/ApiTokens">@L["NavApiTokens"]</a>
                            <a href="/Requests">@L["NavRequests"]</a>
                            <a href="/api/docs">@L["NavDocs"]</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a href="/Admin">Admin</a>
                            }
                        </nav>

                        <div class="user-menu" style="margin-left:0.5rem;">
                            <details>
                                <summary>@(string.IsNullOrWhiteSpace(displayName) ? "Account" : displayName)</summary>
                                <div class="menu">
                                    <a href="/Billing">@L["NavBilling"]</a>
                                    <a href="/Account">@L["NavAccount"]</a>
                                    <a href="/Account/Settings">@L["NavSettings"]</a>
                                    @if (supportEnabled)
                                    {
                                        <a href="/support">@L["NavSupport"]</a>
                                    }
                                    <form method="post" action="/Account/SignOut" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit">@L["NavSignOut"]</button>
                                    </form>
                                </div>
                            </details>
                        </div>
                    }
                    else
                    {
                        <a href="/pricing">@L["NavPricing"]</a>
                        <a href="/Account/SignIn">@L["NavSignIn"]</a>
                        <a href="/Account/SignUp">@L["NavSignUp"]</a>
                    }

                    <div class="lang-switcher">
                        <details>
                            <summary aria-label="Change language">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10" />
                                    <path d="M2 12h20" />
                                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                                </svg>
                                <span>@cultureLabels[currentCulture]</span>
                            </summary>
                            <div class="menu">
                                @foreach (var loc in supportedCultures)
                                {
                                    <form method="post" action="/set-language" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="culture" value="@loc" />
                                        <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                                        <button type="submit" class="@(loc == currentCulture ? "active" : "")">
                                            <span class="check">@(loc == currentCulture ? "✓" : "")</span>
                                            <span>@cultureNames[loc]</span>
                                        </button>
                                    </form>
                                }
                            </div>
                        </details>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main>
        <div class="@((isHomePage ? "" : "main-wrapper") + (isAccountPage ? " auth" : ""))">
            @RenderBody()
        </div>
    </main>

    <footer class="footer">
        <div class="footer-container">
            <div class="footer-grid">
                <!-- Company info -->
                <div class="footer-company">
                    <div class="footer-logo">
                        <a href="/" style="text-decoration: none; color: white" class="header-logo">
                            <div class="full-height">
                                <img src="/img/logo-64.png" width="40" height="40" alt="Performance4PDF" style="width:40px;height:40px;" asp-append-version="true" />
                                <div class="header-logo-wordmark">
                                    <strong>Performance4</strong><span>PDF</span>
                                </div>
                            </div>
                        </a>
                    </div>
                    <p class="footer-company-text">@L["FooterCreatedBy"]</p>
                    <div>
                        <p class="footer-contact-label">@L["FooterContactInfo"]</p>
                        <a href="mailto:support@performance4.cz"
                            class="footer-contact-email">support@performance4.cz</a>
                    </div>
                </div>

                <!-- Legal links -->
                <div class="footer-links-section">
                    <h4>@L["FooterLegal"]</h4>
                    <ul class="footer-links">
                        <li><a href="/Legal/TermsOfService">Terms of Service</a></li>
                        <li><a href="/Legal/PrivacyPolicy">Privacy Policy</a></li>
                        <li><a href="/Legal/DataProcessingAgreement">DPA</a></li>
                        <li><a href="/Legal/ServiceLevelAgreement">SLA</a></li>
                        <li><a href="/Legal/RefundPolicy">Refund Policy</a></li>
                        <li><a href="/Legal/CookiesPolicy">Cookies Policy</a></li>
                    </ul>
                </div>

                <!-- Resources -->
                <div class="footer-links-section">
                    <h4>@L["FooterResources"]</h4>
                    <ul class="footer-links">
                        <li><a href="/Legal/OpenSourceNotices">Open-Source Notices</a></li>
                        <li><a href="/Legal/License">AGPL License</a></li>
                    </ul>
                </div>
            </div>

            <!-- Bottom bar -->
            <div class="footer-bottom">
                <p class="footer-copyright">© 2025 Performance4 s.r.o.</p>
                <div class="footer-social">
                    <a href="https://github.com/janprasil/dotnet-signing-server/">GitHub</a>
                </div>
            </div>
        </div>
    </footer>
    @RenderSection("Scripts", required: false)
</body>

</html>

@inject Microsoft.Extensions.Localization.IStringLocalizer<DotNetSigningServer.Resources.SharedStrings> L
@{
    ViewData["Title"] = L["VerifyEmailTitle"].Value;
}

<h1>@L["VerifyEmailHeading"]</h1>

@{
    var verified = ViewData["Verified"] as bool? ?? false;
    var token = ViewData["Token"] as string;
}

@if (!string.IsNullOrWhiteSpace(token))
{
    @* The verification link only renders this form — the state change happens on
       POST so it can't be triggered cross-site. *@
    <p class="text-small">@L["ConfirmEmailVerificationPrompt"]</p>
    <form method="post" action="/Account/Verify">
        @Html.AntiForgeryToken()
        <input type="hidden" name="token" value="@token" />
        <button type="submit" class="btn btn-primary">@L["ConfirmEmailVerification"]</button>
    </form>
}

<p class="text-small">
    @L["VerificationLinkSent"]
    @if (TempData["Error"] != null)
    {
    <div class="flash error">@TempData["Error"]</div>
}
@if (TempData["Info"] != null)
{
    <div class="flash info">@TempData["Info"]</div>
}
@if (verified)
{
    <div class="flash info" style="display:inline-block;margin-left:0.5rem;">@L["VerifyEmailConfirmedMsg"]</div>
}
</p>

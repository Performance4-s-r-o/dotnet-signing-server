@model DotNetSigningServer.Models.SignUpViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<DotNetSigningServer.Resources.SharedStrings> L
@{
    ViewData["Title"] = L["SignUpLinkText"].Value;
}
<h1>@L["CreateAccountHeading"]</h1>

@if (TempData["Error"] != null)
{
    <div class="flash error">@TempData["Error"]</div>
}
@if (TempData["Info"] != null)
{
    <div class="flash info">@TempData["Info"]</div>
}
@if (ViewData.ModelState.TryGetValue(string.Empty, out var formErrors) && formErrors.Errors.Count > 0)
{
    <div class="flash error">@Html.ValidationSummary(excludePropertyErrors: true)</div>
}
<form method="post" class="auth-form">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label asp-for="Email" class="form-label">@L["EmailLabel"]</label>
        <input asp-for="Email" class="form-input" />
        <span asp-validation-for="Email" class="form-validation"></span>
    </div>
    <div class="form-group">
        <label asp-for="Password" class="form-label">@L["PasswordLabel"]</label>
        <input asp-for="Password" type="password" class="form-input" />
        <span asp-validation-for="Password" class="form-validation"></span>
    </div>
    <div class="form-group">
        <label asp-for="ConfirmPassword" class="form-label">@L["ConfirmPasswordLabel"]</label>
        <input asp-for="ConfirmPassword" type="password" class="form-input" />
        <span asp-validation-for="ConfirmPassword" class="form-validation"></span>
    </div>

    @{
        var granted = Model.Documents.Where(d => d.Action == DotNetSigningServer.Models.ConsentActions.Granted).ToList();
        var acknowledged = Model.Documents.Where(d => d.Action == DotNetSigningServer.Models.ConsentActions.Acknowledged).ToList();
    }
    @if (Model.ShowVersions)
    {
        foreach (var document in Model.Documents)
        {
            <input type="hidden" name="ShownVersions[@document.Document]" value="@document.Version" />
            if (document.ContentHash != null)
            {
                <input type="hidden" name="ShownHashes[@document.Document]" value="@document.ContentHash" />
            }
        }
    }
    @* The service publishes the wording and versions it; this app's own sentence is the
       fallback for when the module is off or the service has nothing for this context. *@
    @if (Model.Prompt is { } prompt)
    {
        <input type="hidden" asp-for="PromptKey" value="@prompt.Key" />
        <input type="hidden" asp-for="PromptVersion" value="@prompt.PromptVersion" />
        <input type="hidden" asp-for="PromptHash" value="@prompt.PromptHash" />
        <input type="hidden" asp-for="PromptDocuments" value="@string.Join(",", prompt.Documents)" />
    }
    <div class="form-group">
        <label class="form-check">
            <input asp-for="AcceptTerms" type="checkbox" required />
            <span>
                @if (Model.Prompt is { } shown)
                {
                    @DotNetSigningServer.Services.Consents.ConsentPromptHtml.Sentence(shown)
                }
                else
                {
                    @DotNetSigningServer.Services.Consents.ConsentHtml.Sentence(L, "SignUpAcceptTermsDpa",
                        DotNetSigningServer.Services.Consents.ConsentHtml.Links(Url, L, granted, Model.ShowVersions))
                }
            </span>
        </label>
        <span asp-validation-for="AcceptTerms" class="form-validation"></span>
    </div>
    @if (acknowledged.Count > 0)
    {
        <p class="muted">@DotNetSigningServer.Services.Consents.ConsentHtml.Sentence(L, "SignUpPrivacyNotice",
            DotNetSigningServer.Services.Consents.ConsentHtml.Links(Url, L, acknowledged, Model.ShowVersions))</p>
    }

    <button type="submit" class="btn btn-primary">@L["SignUpButton"]</button>
</form>

<p class="muted text-center mt-3">@L["AlreadyHaveAccount"] <a href="/Account/SignIn">@L["SignInLinkText"]</a>.</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@inject Microsoft.Extensions.Localization.IStringLocalizer<DotNetSigningServer.Resources.SharedStrings> L
@inject Microsoft.Extensions.Options.IOptions<DotNetSigningServer.Options.P4BackofficeProductOptions> Backoffice
@{
    ViewData["Title"] = L["ContactTitle"].Value;
    ViewData["MetaDescription"] = L["ContactMetaDescription"].Value;
}

<h1>@L["ContactTitle"]</h1>

<div class="ui doubling two column grid" style="font-size: 1.05em; line-height: 1.5em;">
    <div class="column">
        <strong>Performance4 s.r.o.</strong>
        <br />
        <br>Husova 429
        <br>373 67 Borek
        <br />
        <br>@L["ContactIdNumber"] 08415765
        <br>@L["ContactVatNumber"] CZ08415765
    </div>
</div>

<p>
    @L["ContactEmailLabel"] <a href="mailto:support@performance4.cz">support@performance4.cz</a><br />
</p>

@* The public support form is the service's, hosted by the legal viewer and framed here: the
   captcha, the attachment rules and the helpdesk connection live there, and a browser cannot
   reach the service directly. Without P4_BACKOFFICE_SUPPORTFORM__PRODUCT the page is what it
   always was — an address and the mail link above. *@
@{ var supportForm = Backoffice.Value.SupportForm; }
@if (supportForm.ScriptSrc is { } supportSrc)
{
    <h2>@L["ContactFormHeading"]</h2>
    <noscript>
        <p><a href="@supportForm.PageUrl" target="_blank" rel="noopener noreferrer">@L["ContactFormStandalone"]</a></p>
    </noscript>
    <div id="p4-support"></div>
    @* A frame inherits nothing from this page, so it gets the page's own colours (body background,
       --color-text) instead of the widget's defaults: it reads as part of the page. *@
    <script src="@supportSrc" data-product="@supportForm.DataProduct" data-target="#p4-support"
            data-lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-min-height="520"
            data-bg="#ffffff" data-fg="#0f172a"></script>
}

@inject Microsoft.Extensions.Localization.IStringLocalizer<DotNetSigningServer.Resources.SharedStrings> L
@inject DotNetSigningServer.Services.Pricing.ICreditPricingProvider Pricing
@{
    // Current price of 100 credits (Modules:Pricing: the service's price list or Billing:*).
    var culture = System.Globalization.CultureInfo.CurrentUICulture;
    var currency = Pricing.Currency;
    var price100 = DotNetSigningServer.Services.Pricing.CreditPricing.FormatAmount(Pricing.PricePer100, culture);
    var discounts = Pricing.GetPacks()
        .Select(p => (p.Quantity, Percent: p.DiscountPercentVersus(Pricing.PricePer100)))
        .Where(d => d.Percent > 0)
        .ToList();
    // The translated text lists the configured discounts (5 / 10 / 15 %); other prices are listed as they are.
    var standardDiscounts = discounts.SequenceEqual(new[] { (300, 5), (500, 10), (1000, 15) });
    var discountText = standardDiscounts
        ? L["PricingPaidFeature3"].Value
        : L["PricingPaidDiscounts", string.Join(", ", discounts.Select(d =>
            $"{d.Quantity.ToString("N0", culture)}+ ({(d.Percent / 100m).ToString("P0", culture)})"))].Value;
    ViewData["Title"] = L["PricingTitle"].Value;
    ViewData["MetaDescription"] = L["PricingMetaDescription"].Value;
}

<h1>@L["PricingTitle"]</h1>
<p class="muted">@L["PricingDesc"]</p>

<div class="pricing-grid">
    <div class="pricing-card">
        <div class="flex flex-col">
            <h2 class="pricing-title">@L["PricingFreeTitle"]</h2>
            <p class="muted pricing-description">@L["PricingFreeDesc"]</p>
            <p class="pricing-price">0 @currency</p>
            <p class="muted pricing-note">@L["PricingFreeNote"]</p>
            <ul class="list list-none-style">
                <li>@L["PricingFreeFeature1"]</li>
                <li>@L["PricingFreeFeature2"]</li>
            </ul>
        </div>
        <a href="/Account/SignUp" class="btn btn-primary">@L["PricingGetStarted"]</a>
    </div>

    <div class="pricing-card pricing-card--highlight">
        <div class="flex flex-col">
            <h2 class="pricing-title">@L["PricingPaidTitle"]</h2>
            <p class="muted pricing-description">@L["PricingPaidDesc"]</p>
            <p class="pricing-price">@price100 @currency<span style="font-size:1rem;font-weight:600;"></span>
            </p>
            <p class="muted pricing-note">@L["PricingPaidNote"]</p>
            <ul class="list list-none-style">
                <li>@L["PricingPaidFeature1"]</li>
                <li>@L["PricingPaidFeature2"]</li>
                @if (discounts.Count > 0)
                {
                    <li>@discountText</li>
                }
            </ul>
        </div>
        <a href="/Account/SignUp" class="btn btn-primary">@L["PricingGetStarted"]</a>
    </div>
</div>

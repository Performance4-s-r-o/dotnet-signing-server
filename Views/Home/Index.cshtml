@inject Microsoft.Extensions.Localization.IStringLocalizer<DotNetSigningServer.Resources.SharedStrings> L
@{
  @* _Layout appends " | Performance4PDF" — do not repeat it here. *@
  ViewData["Title"] = L["HomeSeoTitle"].Value;
  ViewData["MetaDescription"] = L["HomeMetaDescription"].Value;
  var signupSuccess = ViewData["SignupSuccess"] as bool? ?? false;
}

@if (signupSuccess)
{
  <div class="flash info m-0">@L["HomeSignupSuccess"]</div>
}

<section class="hero">
  <div class="hero-container">
    <div class="hero-grid">
      <!-- Left side - Content -->
      <div class="hero-content">
        <h1 class="hero-title">@L["HomeHeroTitle"]</h1>

        <p class="hero-description">
          @L["HomeHeroDescription"]
        </p>

        <div class="hero-buttons">
          <a href="/api/docs" class="btn btn-primary">
            @L["HomeApiDocs"]
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
          <a href="https://github.com/Performance4-s-r-o/dotnet-signing-server/tree/main/examples"
             class="btn btn-secondary">@L["HomeExampleIntegration"]</a>
        </div>
      </div>

      <!-- Right side - Code example morphing into the signed document viewer.
           Both layers share one CSS animation cycle (see .hero-stage in custom.css). -->
      <div class="hero-stage">
        <div class="hero-code">
          @await Html.PartialAsync("_WindowChrome", L["HomeExampleApiRequest"].Value)
          @* <pre> preserves whitespace, so every line must start at column 0 —
             source indentation would otherwise show up as leading spaces. *@
          <pre><code><span class="code-accent">POST</span> /api/sign
<span class="code-dim">Authorization:</span> Bearer &lt;token&gt;
<span class="code-dim">Content-Type:</span> application/json

<span class="code-white">{</span>
  <span class="code-accent">"id"</span>: <span class="code-string">"ef2c...4d7a"</span>,
  <span class="code-accent">"signedHash"</span>: <span class="code-string">"iVB0Rw0KGgo..."</span>
<span class="code-white">}</span></code></pre>

          <div class="hero-code-response" aria-hidden="true">
            <svg class="hero-code-response-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"
                 stroke-linejoin="round">
              <path d="M12 4v12" />
              <path d="m6 12 6 6 6-6" />
              <path d="M4 20h16" />
            </svg>
            <span class="hero-code-status">200 OK</span>
            <span class="hero-code-file">signed.pdf</span>
            <span class="hero-code-progress"><span class="hero-code-progress-bar"></span></span>
          </div>
        </div>

        <div class="hero-doc" aria-hidden="true">
          @await Html.PartialAsync("_WindowChrome", L["HomeHeroSignedDocument"].Value)

          <div class="hero-doc-body">
            <svg class="hero-doc-page" viewBox="0 0 340 300" focusable="false">
              <defs>
                <linearGradient id="heroChartFill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#dcf3e8" />
                  <stop offset="1" stop-color="#b6e4d1" />
                </linearGradient>
              </defs>

              <rect x="0" y="0" width="340" height="300" rx="5" fill="#f6f8fa" />

              <!-- Title row -->
              <g class="doc-block doc-block--1">
                <rect x="22" y="22" width="118" height="26" rx="3" fill="#b8d0e4" />
                <rect x="196" y="26" width="122" height="7" rx="3.5" fill="#ccd9e6" />
                <rect x="196" y="41" width="62" height="7" rx="3.5" fill="#ccd9e6" />
                <line x1="22" y1="66" x2="318" y2="66" stroke="#e2e8f0" stroke-width="1.5" />
              </g>

              <!-- Paragraph + chart -->
              <g class="doc-block doc-block--2">
                <rect x="22" y="82" width="150" height="7" rx="3.5" fill="#c6d5e4" />
                <rect x="22" y="97" width="168" height="7" rx="3.5" fill="#ccd9e6" />
                <rect x="22" y="112" width="160" height="7" rx="3.5" fill="#ccd9e6" />
                <rect x="22" y="127" width="166" height="7" rx="3.5" fill="#ccd9e6" />
                <rect x="22" y="142" width="110" height="7" rx="3.5" fill="#ccd9e6" />
                <rect x="204" y="82" width="114" height="62" rx="4" fill="url(#heroChartFill)" />
                <path d="M204 130l24-16 18 11 22-22 20 15 20-18v38a4 4 0 0 1-4 4h-96a4 4 0 0 1-4-4z"
                      fill="#8fd3b6" opacity=".7" />
                <line x1="22" y1="162" x2="318" y2="162" stroke="#e2e8f0" stroke-width="1.5" />
              </g>

              <!-- Three data columns -->
              <g class="doc-block doc-block--3">
                <rect x="22" y="176" width="44" height="7" rx="3.5" fill="#b8cadd" />
                <rect x="22" y="192" width="80" height="7" rx="3.5" fill="#ccd9e6" />
                <rect x="22" y="205" width="72" height="7" rx="3.5" fill="#ccd9e6" />
                <rect x="22" y="218" width="78" height="7" rx="3.5" fill="#ccd9e6" />
                <rect x="22" y="231" width="58" height="7" rx="3.5" fill="#ccd9e6" />

                <rect x="124" y="176" width="44" height="7" rx="3.5" fill="#b8cadd" />
                <rect x="124" y="192" width="80" height="7" rx="3.5" fill="#ccd9e6" />
                <rect x="124" y="205" width="72" height="7" rx="3.5" fill="#ccd9e6" />
                <rect x="124" y="218" width="78" height="7" rx="3.5" fill="#ccd9e6" />
                <rect x="124" y="231" width="58" height="7" rx="3.5" fill="#ccd9e6" />

                <rect x="226" y="176" width="44" height="7" rx="3.5" fill="#b8cadd" />
                <rect x="226" y="192" width="80" height="7" rx="3.5" fill="#ccd9e6" />
                <rect x="226" y="205" width="72" height="7" rx="3.5" fill="#ccd9e6" />
                <rect x="226" y="218" width="78" height="7" rx="3.5" fill="#ccd9e6" />
                <rect x="226" y="231" width="58" height="7" rx="3.5" fill="#ccd9e6" />

                <line x1="22" y1="250" x2="318" y2="250" stroke="#e2e8f0" stroke-width="1.5" />
                <rect x="22" y="264" width="52" height="7" rx="3.5" fill="#c6d5e4" />
                <line x1="22" y1="288" x2="150" y2="288" stroke="#cbd5e1" stroke-width="1.5"
                      stroke-dasharray="4 4" />
              </g>

              <!-- Handwritten signature, drawn stroke by stroke -->
              <path class="doc-signature" pathLength="1" fill="none" stroke="#2fae8b" stroke-width="2.6"
                    stroke-linecap="round" stroke-linejoin="round"
                    d="M74 290c10-20 18-42 26-38s-2 34 6 36 20-26 28-26 2 20 10 20 14-10 18-18" />

              <!-- Spotlight: dims the page while the seal is highlighted -->
              <rect class="doc-dim" x="0" y="0" width="340" height="300" rx="5" fill="#0f172a" />

              <circle class="doc-seal-ring doc-seal-ring--1" cx="280" cy="262" r="29" fill="none"
                      stroke="#38bdf8" stroke-width="2" />
              <circle class="doc-seal-ring doc-seal-ring--2" cx="280" cy="262" r="29" fill="none"
                      stroke="#38bdf8" stroke-width="2" />

              <g class="doc-seal">
                <circle cx="280" cy="262" r="25" fill="none" stroke="#9ec0e2" stroke-width="4.5"
                        stroke-dasharray="3 2.6" />
                <circle cx="280" cy="262" r="20" fill="#eef4fb" stroke="#9ec0e2" stroke-width="1.6" />
                <circle cx="280" cy="262" r="15" fill="none" stroke="#9ec0e2" stroke-width="1.4" />
                <rect x="271" y="256" width="18" height="2.6" rx="1.3" fill="#8fb6dd" />
                <rect x="271" y="261" width="18" height="2.6" rx="1.3" fill="#8fb6dd" />
                <rect x="274" y="266" width="12" height="2.6" rx="1.3" fill="#8fb6dd" />
              </g>
            </svg>

            <span class="hero-doc-badge">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="m5 13 4 4L19 7" />
              </svg>
              @L["HomeHeroSignatureVerified"]
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

  <!-- ============================================
       FEATURES SECTION
       ============================================ -->
  <section class="features">
    <div class="features-groups">

      <!-- Feature Group 1: Generate PDFs -->
      <div class="feature-group">
        <div class="feature-group-header">
          <h2 class="feature-group-title">@L["HomeFeatureGenerateTitle"]</h2>
          <p class="feature-group-description">
            @L["HomeFeatureGenerateDescription"]
          </p>
        </div>

        <div class="feature-cards">
          <div class="feature-card">
            <div class="feature-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                <path d="M14 2v4a2 2 0 0 0 2 2h4" />
              </svg>
            </div>
            <h3 class="feature-card-title">@L["HomeVisualFieldMappingTitle"]</h3>
            <p class="feature-card-description">@L["HomeVisualFieldMappingDescription"]</p>
          </div>

          <div class="feature-card">
            <div class="feature-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path
                d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z" />
                <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65" />
                <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65" />
              </svg>
            </div>
            <h3 class="feature-card-title">@L["HomeDynamicDataBindingTitle"]</h3>
            <p class="feature-card-description">@L["HomeDynamicDataBindingDescription"]</p>
          </div>

        </div>
      </div>

      <!-- Feature Group 2: Digital signatures -->
      <div class="feature-group">
        <div class="feature-group-header">
          <h2 class="feature-group-title">@L["HomeFeatureSigningTitle"]</h2>
          <p class="feature-group-description">
            @L["HomeFeatureSigningDescription"]
          </p>
        </div>

        <div class="feature-cards">
          <div class="feature-card">
            <div class="feature-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
                <path d="m9 12 2 2 4-4" />
              </svg>
            </div>
            <h3 class="feature-card-title">@L["HomeCertificateSigningTitle"]</h3>
            <p class="feature-card-description">@L["HomeCertificateSigningDescription"]</p>
          </div>

          <div class="feature-card">
            <div class="feature-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
            </div>
            <h3 class="feature-card-title">@L["HomeTrustedTimestampsTitle"]</h3>
            <p class="feature-card-description">@L["HomeTrustedTimestampsDescription"]</p>
          </div>

          <div class="feature-card">
            <div class="feature-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
            </div>
            <h3 class="feature-card-title">@L["HomeMultipleSignaturesTitle"]</h3>
            <p class="feature-card-description">@L["HomeMultipleSignaturesDescription"]</p>
          </div>
        </div>
      </div>

      <!-- Feature Group 3: Embed attachments -->
      <div class="feature-group">
        <div class="feature-group-header">
          <h2 class="feature-group-title">@L["HomeFeatureAttachmentsTitle"]</h2>
          <p class="feature-group-description">
            @L["HomeFeatureAttachmentsDescription"]
          </p>
        </div>

        <div class="feature-cards">
          <div class="feature-card">
            <div class="feature-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path
                d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" />
              </svg>
            </div>
            <h3 class="feature-card-title">@L["HomeAnyFileTypeTitle"]</h3>
            <p class="feature-card-description">@L["HomeAnyFileTypeDescription"]</p>
          </div>

          <div class="feature-card">
            <div class="feature-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path
                d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
                <path d="M12 10v6" />
                <path d="m9 13 3-3 3 3" />
              </svg>
            </div>
            <h3 class="feature-card-title">@L["HomeEvidenceBundlesTitle"]</h3>
            <p class="feature-card-description">@L["HomeEvidenceBundlesDescription"]</p>
          </div>

          <div class="feature-card">
            <div class="feature-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <ellipse cx="12" cy="5" rx="9" ry="3" />
                <path d="M3 5v14a9 3 0 0 0 18 0V5" />
                <path d="M3 12a9 3 0 0 0 18 0" />
              </svg>
            </div>
            <h3 class="feature-card-title">@L["HomeMetadataSupportTitle"]</h3>
            <p class="feature-card-description">@L["HomeMetadataSupportDescription"]</p>
          </div>
        </div>
      </div>

      <!-- Feature Group 4: QR & barcodes -->
      <div class="feature-group">
        <div class="feature-group-header">
          <h2 class="feature-group-title">@L["HomeFeatureCodesTitle"]</h2>
          <p class="feature-group-description">
            @L["HomeFeatureCodesDescription"]
          </p>
        </div>

        <div class="feature-cards">
          <div class="feature-card">
            <div class="feature-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="5" height="5" x="3" y="3" rx="1" />
                <rect width="5" height="5" x="16" y="3" rx="1" />
                <rect width="5" height="5" x="3" y="16" rx="1" />
                <path d="M21 16h-3a2 2 0 0 0-2 2v3" />
                <path d="M21 21v.01" />
                <path d="M12 7v3a2 2 0 0 1-2 2H7" />
                <path d="M3 12h.01" />
                <path d="M12 3h.01" />
                <path d="M12 16v.01" />
                <path d="M16 12h1" />
                <path d="M21 12v.01" />
                <path d="M12 21v-1" />
              </svg>
            </div>
            <h3 class="feature-card-title">@L["HomeMultiCodeTitle"]</h3>
            <p class="feature-card-description">@L["HomeMultiCodeDescription"]</p>
          </div>

          <div class="feature-card">
            <div class="feature-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <circle cx="12" cy="12" r="6" />
                <circle cx="12" cy="12" r="2" />
              </svg>
            </div>
            <h3 class="feature-card-title">@L["HomeCoordinatesTitle"]</h3>
            <p class="feature-card-description">@L["HomeCoordinatesDescription"]</p>
          </div>

          <div class="feature-card">
            <div class="feature-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                <path d="m9 11 3 3L22 4" />
              </svg>
            </div>
            <h3 class="feature-card-title">@L["HomeErrorCorrectionTitle"]</h3>
            <p class="feature-card-description">@L["HomeErrorCorrectionDescription"]</p>
          </div>
        </div>
      </div>

    </div>
  </section>

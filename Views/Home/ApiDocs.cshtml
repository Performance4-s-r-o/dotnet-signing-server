@model IReadOnlyList<DotNetSigningServer.Services.ApiEndpointDoc>
@inject Microsoft.Extensions.Localization.IStringLocalizer<DotNetSigningServer.Resources.SharedStrings> L
@{
  ViewData["Title"] = L["ApiDocsTitle"].Value;
  ViewData["MetaDescription"] = L["ApiDocsMetaDescription"].Value;
  var baseUrl = (ViewData["BaseUrl"]?.ToString() ?? string.Empty).TrimEnd('/');
  var apiBase = string.IsNullOrWhiteSpace(baseUrl) ? "/api" : $"{baseUrl}/api";
}

<h1 class="content-box-title">@L["ApiDocsTitle"]</h1>
<p class="muted">
  @L["ApiDocsIntroEndpoints"] <code>@apiBase</code> @L["ApiDocsIntroBase64"]
  <br />
  @L["ApiDocsIntroAuth"] <code>Authorization: Bearer &lt;token&gt;</code>.
</p>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin:1rem 0;">
  <div class="card">
    <strong>@L["ApiDocsCreditsTitle"]</strong>
    <p class="muted" style="margin:6px 0 0;">@L["ApiDocsCreditsDescription"]</p>
  </div>
  <div class="card">
    <strong>@L["ApiDocsLimitsTitle"]</strong>
    <p class="muted" style="margin:6px 0 0;">@L["ApiDocsLimitsDescription"]</p>
  </div>
  <div class="card">
    <strong>@L["ApiDocsAbuseTitle"]</strong>
    <p class="muted" style="margin:6px 0 0;">@L["ApiDocsAbuseDescription"]</p>
  </div>
</div>

<h2 class="tokens-existing-title">@L["ApiDocsOverviewTitle"]</h2>
<div class="table-wrapper">
  <table class="table">
    <thead>
      <tr>
        <th>@L["ApiDocsColumnMethod"]</th>
        <th>@L["ApiDocsColumnPath"]</th>
        <th>@L["ApiDocsColumnPurpose"]</th>
        <th>@L["ApiDocsColumnCredits"]</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var endpoint in Model)
      {
        <tr>
          <td>@endpoint.Method</td>
          <td><a href="/api/docs/@endpoint.Slug"><code>@endpoint.Path</code></a></td>
          <td>@L[endpoint.PurposeKey]</td>
          <td>@L[endpoint.CreditsKey]</td>
        </tr>
      }
    </tbody>
  </table>
</div>

<h2 class="tokens-existing-title mt-4 mb-4">@L["ApiDocsReferenceTitle"]</h2>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px;">
  @foreach (var endpoint in Model)
  {
    <a class="card" href="/api/docs/@endpoint.Slug" style="text-decoration:none;display:block;">
      <strong>@L[endpoint.TitleKey]</strong>
      <p class="muted" style="margin:6px 0 0;"><code>@endpoint.Method @endpoint.Path</code></p>
      <p class="muted" style="margin:6px 0 0;">@L[endpoint.PurposeKey]</p>
    </a>
  }
</div>

<p class="muted" style="margin-top:1.5rem;">@L["ApiDocsHelp"]</p>

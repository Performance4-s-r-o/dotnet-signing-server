@inject Microsoft.Extensions.Localization.IStringLocalizer<DotNetSigningServer.Resources.SharedStrings> L
@using DotNetSigningServer.Services.Support
@{
    ViewData["Title"] = L["SupportTitle"].Value;
    var categories = ViewData["SupportCategories"] as IReadOnlyList<SupportCategoryOption> ?? SupportCategoriesProvider.Defaults;
    var selectedCategory = categories.Any(c => c.Key == SupportTicketRequest.FallbackCategory)
        ? SupportTicketRequest.FallbackCategory
        : categories.FirstOrDefault()?.Key;
}
@functions {
    // Labels of the form's own categories (used while the service's list is not in use).
    private static readonly Dictionary<string, string> FallbackLabels = new()
    {
        ["signing"] = "SupportCategorySigning",
        ["templates"] = "SupportCategoryTemplates",
        ["billing"] = "SupportCategoryBilling",
        ["account"] = "SupportCategoryAccount",
        ["other"] = "SupportCategoryOther",
    };
}
<h1>@L["SupportTitle"]</h1>
<p class="muted mt-2 mb-3">@L["SupportDesc"]</p>

@if (TempData["Info"] is string info)
{
    <div class="flash-info">@info</div>
}
@if (TempData["Error"] is string error)
{
    <div class="flash-error">@error</div>
}

<div class="card">
    <h2>@L["SupportSubmitTicketTitle"]</h2>
    @if (ViewData["UserEmail"] is string userEmail && !string.IsNullOrWhiteSpace(userEmail))
    {
        <p class="muted mb-3">@L["SupportReplyToHint", userEmail]</p>
    }
    <form method="post" action="/support/ticket">
        @Html.AntiForgeryToken()
        <input type="hidden" name="formKey" value="@(ViewData["SupportFormKey"] as string)" />

        <div class="form-group">
            <label for="category">@L["SupportCategory"]</label>
            <select name="category" id="category" required>
                @foreach (var option in categories)
                {
                    var label = option.Label ?? (FallbackLabels.TryGetValue(option.Key, out var resource) ? L[resource].Value : option.Key);
                    <option value="@option.Key" selected="@(option.Key == selectedCategory)">@label</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label for="priority">@L["SupportPriority"]</label>
            <select name="priority" id="priority">
                <option value="low">@L["SupportPriorityLow"]</option>
                <option value="normal" selected>@L["SupportPriorityNormal"]</option>
                <option value="high">@L["SupportPriorityHigh"]</option>
            </select>
        </div>

        <div class="form-group">
            <label for="subject">@L["SupportSubjectLabel"]</label>
            <input type="text" name="subject" id="subject" maxlength="@SupportTicketRequest.MaxSubjectLength" placeholder="@L["SupportSubjectPlaceholder"]" required />
        </div>

        <div class="form-group">
            <label for="message">@L["SupportMessageLabel"]</label>
            <textarea name="message" id="message" rows="6" maxlength="@SupportTicketRequest.MaxMessageLength" placeholder="@L["SupportMessagePlaceholder"]" required></textarea>
        </div>

        <button type="submit" class="btn btn-primary">@L["SupportSubmitButton"]</button>
    </form>
</div>

<div class="card mt-3">
    <h2>@L["SupportContactTitle"]</h2>
    <p><strong>@L["SupportEmailLabel"]</strong> <a href="mailto:support@performance4.cz">support@performance4.cz</a></p>
    <p><strong>@L["SupportCompanyLabel"]</strong> Performance4 s.r.o.</p>
</div>

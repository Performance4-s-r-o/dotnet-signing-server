# Copy to .env and fill in what you need. Every section is optional except the
# database, token secret and hostname — leave a section empty and the matching
# feature switches itself off instead of failing at startup.
#
# .env is gitignored. Never commit real credentials.

# ── Core ──────────────────────────────────────────────────────────────────────
# Used only by a local docker-compose.override.yml that publishes the port; the shipped
# docker-compose.yml only `expose`s 8085/8086 to the Docker network (#78).
HTTP_PORT=8085
# Second listener for a trusted internal caller (#78); that caller's token works there only (401 on
# 8085). Empty = one listener, a plain API.
INTERNAL_API_PORT=
# Service account id(s) of the trusted caller, comma-separated GUIDs. Required when
# INTERNAL_API_PORT is set. Only this account, on the internal port, may skip the attachment debit
# and send X-P4-Tenant / X-Request-Id. Old name PORTAL_USER_IDS is still read, with a warning.
TRUSTED_CALLER_USER_IDS=
# cloudflared's address or CIDR, comma-separated (#106). CF-Connecting-IP is the client only for a
# request that came from it (directly or through a TRUSTED_PROXIES proxy). Production refuses to
# start while empty; `none` = no Cloudflare tunnel in front of this server.
TRUSTED_CF_PROXIES=
# Reverse-proxy (Traefik/Caddy) addresses or CIDRs (#106): whose X-Forwarded-For is believed.
# Empty = the private ranges (the old default); `none` = nobody's.
TRUSTED_PROXIES=
FQDN_SERVER=localhost:8085
ALLOWED_HOSTS=*

# Signing key for issued API tokens. Generate with:
#   openssl rand -base64 48
TOKEN_SECRET=

# ── Database ──────────────────────────────────────────────────────────────────
# Either one URL (the portal's shape; wins when set; the schema is not part of it):
#   postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=
# …or the parts below.
DB_HOST=postgres
DB_PORT=5432
# Npgsql pool (#75). Keep it under the role's connection limit (25).
DB_MAX_POOL_SIZE=20
# Per-command timeout in seconds; the role's statement_timeout (15s) is the other half.
DB_COMMAND_TIMEOUT_SECONDS=15
DB_NAME=signing
DB_USER=signing
DB_PASSWORD=
# Schema migrations are a release step, not part of every start (#85):
#   dotnet dotnet-signing-server.dll --migrate
# Run it once before the new version starts, with the migration role below
# (needs DDL rights; the runtime role DB_USER does not). Empty = DB_USER migrates.
# `docker compose run --rm migrate` reads these; the serving container never does.
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=
# The migration role as one URL instead; wins over MIGRATION_DB_USER / _PASSWORD.
MIGRATION_DATABASE_URL=
# true = migrate on every start (single instance / on-prem only, runtime role needs DDL).
# false = the server refuses to start while migrations are pending.
RUN_MIGRATIONS_ON_START=false

# ── Timestamp authority (RFC 3161) ────────────────────────────────────────────
# Nothing to configure. The server has no TSA of its own: a timestamp is applied
# only when a request carries tsaUrl, and that URL must be HTTPS and public.

# ── Server-side seal ──────────────────────────────────────────────────────────
# Supply the PKCS#12 either as a mounted path or a single-line base64 blob.
SEAL_ENABLED=false
SEAL_PFX_PATH=
SEAL_PFX_BASE64=
SEAL_PFX_PASSWORD=
# Written into every sealed document. Leave empty unless it names the
# organisation the seal certificate belongs to.
SEAL_LOCATION=

# ── SES evidence encryption ───────────────────────────────────────────────────
# Certificate used to encrypt the evidence attachment. Base64 is the safe form:
# some platforms mangle multi-line values on .env export.
EVIDENCE_ENCRYPTION_CERTIFICATE_PEM=
EVIDENCE_ENCRYPTION_CERTIFICATE_PEM_BASE64=

# ── Billing (Stripe) ──────────────────────────────────────────────────────────
# In production the webhook secret must start with whsec_ or startup fails.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=EUR
STRIPE_ENABLE_TAX_ID_COLLECTION=true
STRIPE_REQUIRE_BILLING_ADDRESS=true
STRIPE_ENABLE_AUTOMATIC_TAX=true

# Shared key that lets a trusted caller skip the attachment debit. Must match
# the same key on the calling service. Leave empty to disable the bypass.
BILLING_ATTACHMENT_DEBIT_BYPASS_KEY=

# ── Transactional email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# ── Support helpdesk (osTicket) ───────────────────────────────────────────────
# Without Url + ApiKey the support routes 404 and the nav entry is hidden.
OSTICKET_URL=
OSTICKET_API_KEY=
OSTICKET_TOPIC_SIGNING=1
OSTICKET_TOPIC_TEMPLATES=2
OSTICKET_TOPIC_BILLING=3
OSTICKET_TOPIC_ACCOUNT=4
OSTICKET_TOPIC_OTHER=5

# ── AI-assisted template fields (optional) ────────────────────────────────────
AI_ENABLED=false
AI_PROVIDER=google
AI_GOOGLE_API_KEY=
AI_GOOGLE_MODEL=gemini-1.5-flash
AI_GOOGLE_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# ── Error monitoring (Sentry) ─────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_DEBUG=false
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ENVIRONMENT=production
# Short git SHA from the build pipeline; forms the release name with the build date.
SENTRY_RELEASE_SHA=

# ── Log shipping (Loki) ───────────────────────────────────────────────────────
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_BEARER_TOKEN=
LOKI_APP=dotnet-signing-server
LOKI_ENVIRONMENT=development

# ── Limits ────────────────────────────────────────────────────────────────────
PDF_MAX_BYTES=20971520
IMAGE_MAX_BYTES=1048576
ATTACHMENT_MAX_BYTES=10485760
REQUEST_BODY_LIMIT_BYTES=41943040
MAX_CONCURRENT_REQUESTS_PER_KEY=25
# Refuse PDFs with a Launch action or JavaScript that runs on open (true/false). false turns the whole check off.
REJECT_ACTIVE_CONTENT=true
# find-codes: ImageMagick pixel-cache memory for the process, bytes. 0 = by cores (1.5 GB below 8, 2.5 GB from 8).
FIND_CODES_MAGICK_MEMORY_BYTES=0
# Results of paid operations above this size are delivered but not kept for an Idempotency-Key replay.
OPERATION_MAX_STORED_RESULT_BYTES=26214400
# Seconds per TSA authority (primary, then backup); keep primary + backup well under the portal's wait.
TSA_TIMEOUT_SECONDS=10
# Circuit breaker per TSA host: consecutive failures that open it (0 = off, max 100), and how
# long it then refuses calls at once before one probe is let through (1-3600). Invalid = startup fails.
TSA_BREAKER_FAILURE_THRESHOLD=5
TSA_BREAKER_OPEN_SECONDS=30
# Deadline of a paid call, seconds (1-95; Cloudflare answers 524 after 100 s): sign/sign-pfx/
# timestamp/visual-sign/seal/attachment, then fill-pdf and pdfa, then find-codes/extend-signature/AI.
OPERATION_DEADLINE_SIGN_SECONDS=45
OPERATION_DEADLINE_DOCUMENT_SECONDS=60
OPERATION_DEADLINE_HEAVY_SECONDS=75

# ── P4 Backoffice (shared legal documents, consents, e-mail, pricing, support) ─
# Every module is Off by default and a private server forces Off. Mode is Off,
# Shadow or On; a module override (empty = inherit Mode) wins over Mode. Shadow
# or On needs the URL and a p4sk_ key. Every build can switch it on (no SDK or
# private package is involved).
P4_BACKOFFICE_MODE=Off
P4_BACKOFFICE_URL=
P4_BACKOFFICE_SECRET_KEY=
# live | test — the service environment; the key kind must match it (live =
# p4sk_live_, test = p4sk_test_). Required once a module is Shadow or On, in
# every ASPNETCORE_ENVIRONMENT (the test deployment runs as Production).
P4_BACKOFFICE_ENV=
# Webhook signing secret (whsec_...); the previous one is accepted while rotating.
P4_BACKOFFICE_WEBHOOK_SECRET=
P4_BACKOFFICE_WEBHOOK_PREVIOUS_SECRET=
P4_BACKOFFICE_DOCS_MODE=
P4_BACKOFFICE_CONSENTS_MODE=
P4_BACKOFFICE_EMAIL_MODE=
P4_BACKOFFICE_PRICING_MODE=
P4_BACKOFFICE_SUPPORT_MODE=
# How long an outbox write is retried after its first attempt (TimeSpan, e.g.
# 20:00:00). Empty = 20 h. Must stay under 24 h: the service keeps an
# Idempotency-Key 24 h and a later retry would send the e-mail/ticket twice.
P4_BACKOFFICE_OUTBOX_GIVE_UP_AFTER=
# Templates the service renders while the Email module is On: * for all,
# otherwise keys separated by commas or whitespace (auto_recharge_success,
# auto_recharge_failed, payment_failed, price_change_notice, email_verification,
# password_reset, two_factor_code). Empty renders every message locally. Read
# per message, so narrowing it needs no deployment.
P4_BACKOFFICE_TEMPLATES=
# Cookie banner of the service: set the publishable key (p4pk_...) once the
# declaration has an optional category (analytics, marketing). The widget loads
# from the public legal viewer; P4_BACKOFFICE_WIDGET_URL overrides it.
P4_BACKOFFICE_PK=
P4_BACKOFFICE_WIDGET_URL=

# Public support form on the contact page, hosted by the legal viewer and framed
# there. Set the product slug in the service; the viewer origin defaults to the
# public one (P4_BACKOFFICE_WIDGET_URL is not reused, the two are independent).
# The service must list this app's origin under the product's embed origins, or
# the browser refuses to frame the form.
P4_BACKOFFICE_SUPPORT_FORM_PRODUCT=
P4_BACKOFFICE_SUPPORT_FORM_URL=

# Self-hosted installation: this server becomes an internal API for the portal.
# Billing, the marketing pages, the legal pages and support are removed from
# routing entirely, and signing up is switched off — so the first administrator
# has to be seeded here on the first start. Both values can be removed once the
# account exists.
PrivateServer__Enabled=false
SeedAdmin__Email=
SeedAdmin__Password=

# Per-account caps (#74); 0 = no limit. The portal calls with ONE account for all tenants.
MAX_PENDING_PRESIGNS_PER_USER=0
MAX_TEMPLATES_PER_USER=0
# Live API tokens per account (#80); 0 = no limit. The portal holds one token.
MAX_API_TOKENS_PER_USER=100

# Browser origins allowed to call /api, comma-separated (#80). In production an empty value
# means only this server's own origin: list every site that uses browser tokens.
CORS_ALLOWED_ORIGINS=

# Step-up re-authentication (#80): a password or e-mailed code confirmed within this many
# minutes before creating an API token or changing billing. Wrong 2FA codes before a code is void.
AUTH_REAUTH_MINUTES=15
AUTH_OTP_MAX_FAILED_ATTEMPTS=5
# Sign-in and 2FA attempts per account, whatever the IP (#80): this many per window.
AUTH_ACCOUNT_MAX_ATTEMPTS=30
AUTH_ACCOUNT_WINDOW_MINUTES=15

# Checkout sessions created before this UTC instant are accepted without the product marker
# (#80) — set it to the deploy time + 24 h for the release that introduces the marker,
# then remove it. Empty = strict.
BILLING_PRODUCT_TAG_GRACE_UNTIL=

# Cap on concurrent operations of the whole server (#69). Empty = max(16, 2/3 of the CPUs);
# 0 = off. A request waits GLOBAL_CONCURRENCY_WAIT_MS (default 2000) for a slot, then gets 503.
GLOBAL_CONCURRENCY_LIMIT=
GLOBAL_CONCURRENCY_WAIT_MS=

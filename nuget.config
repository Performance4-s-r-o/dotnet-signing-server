<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources. Only P4.* packages come from the Performance4 GitHub Packages
  feed, and only when the build asks for one (UseP4BackofficeSdk=true); a default
  build never contacts it and needs no token. The token is read from the
  P4_PACKAGES_TOKEN environment variable - never put a value in this file.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="p4" value="https://nuget.pkg.github.com/Performance4-s-r-o/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="p4">
      <package pattern="P4.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <p4>
      <add key="Username" value="token" />
      <add key="ClearTextPassword" value="%P4_PACKAGES_TOKEN%" />
    </p4>
  </packageSourceCredentials>
</configuration>

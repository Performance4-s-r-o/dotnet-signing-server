<Project>
  <!--
    P4 Backoffice SDK switch, shared by the app and the test project.

    The SDK (P4.Backoffice.Sdk) is distributed through a registry that needs a
    token, which forks and public CI do not have. The default build therefore
    leaves it out: everything that touches SDK types lives in
    Services/Backoffice/Sdk/ and is compiled only with UseP4BackofficeSdk=true.
    Such a build behaves exactly like P4Backoffice:Mode=Off.

      dotnet build -p:UseP4BackofficeSdk=true          # package from nuget.config source "p4"
      dotnet build -p:UseP4BackofficeSdk=true -p:P4BackofficeSdkProject=/path/to/P4.Backoffice.Sdk.csproj
                                                        # local SDK sources instead of the package

    Restore and build must see the same value (MSBuild also reads it from the
    environment variable UseP4BackofficeSdk).
  -->
  <PropertyGroup>
    <UseP4BackofficeSdk Condition="'$(UseP4BackofficeSdk)' == ''">false</UseP4BackofficeSdk>
    <P4BackofficeSdkVersion Condition="'$(P4BackofficeSdkVersion)' == ''">0.1.0</P4BackofficeSdkVersion>
    <DefineConstants Condition="'$(UseP4BackofficeSdk)' == 'true'">$(DefineConstants);P4_BACKOFFICE_SDK</DefineConstants>
  </PropertyGroup>
</Project>
